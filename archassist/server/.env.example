PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/archassist
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGIN=http://localhost:5173

# Default admin account (created on first start)
ADMIN_EMAIL=admin@archassist.local
ADMIN_PASSWORD=admin12345

# LLM: auto | anthropic | offline   (auto = anthropic when ANTHROPIC_API_KEY is set)
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Embeddings: local | voyage | openai   (run "npm run reindex" after changing)
EMBEDDING_PROVIDER=local
VOYAGE_API_KEY=
OPENAI_API_KEY=
